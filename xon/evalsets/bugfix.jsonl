{"id": "xon-bug-000", "entry": "sum_to_n", "buggy": "def sum_to_n(n):\n    total = 0\n    for i in range(n):\n        total += i\n    return total\n", "fixed": "def sum_to_n(n):\n    total = 0\n    for i in range(n + 1):\n        total += i\n    return total\n", "tests": ["sum_to_n(3) == 6", "sum_to_n(0) == 0"], "license": "CC0-1.0"}
{"id": "xon-bug-001", "entry": "is_adult", "buggy": "def is_adult(age):\n    return age > 18\n", "fixed": "def is_adult(age):\n    return age >= 18\n", "tests": ["is_adult(18)", "not is_adult(17)"], "license": "CC0-1.0"}
{"id": "xon-bug-002", "entry": "last_item", "buggy": "def last_item(xs):\n    return xs[len(xs)]\n", "fixed": "def last_item(xs):\n    return xs[len(xs) - 1]\n", "tests": ["last_item([1, 2, 3]) == 3"], "license": "CC0-1.0"}
{"id": "xon-bug-003", "entry": "average", "buggy": "def average(xs):\n    return sum(xs) / (len(xs) + 1)\n", "fixed": "def average(xs):\n    return sum(xs) / len(xs)\n", "tests": ["average([2, 4]) == 3"], "license": "CC0-1.0"}
{"id": "xon-bug-004", "entry": "max_val", "buggy": "def max_val(xs):\n    m = xs[0]\n    for x in xs:\n        if x < m:\n            m = x\n    return m\n", "fixed": "def max_val(xs):\n    m = xs[0]\n    for x in xs:\n        if x > m:\n            m = x\n    return m\n", "tests": ["max_val([1, 5, 3]) == 5"], "license": "CC0-1.0"}
{"id": "xon-bug-005", "entry": "count_even", "buggy": "def count_even(xs):\n    return sum(1 for x in xs if x % 2 == 1)\n", "fixed": "def count_even(xs):\n    return sum(1 for x in xs if x % 2 == 0)\n", "tests": ["count_even([1, 2, 4]) == 2"], "license": "CC0-1.0"}
{"id": "xon-bug-006", "entry": "greet", "buggy": "def greet(name):\n    return 'Hello, ' + name + '?'\n", "fixed": "def greet(name):\n    return 'Hello, ' + name + '!'\n", "tests": ["greet('Ann') == 'Hello, Ann!'"], "license": "CC0-1.0"}
{"id": "xon-bug-007", "entry": "factorial", "buggy": "def factorial(n):\n    r = 0\n    for i in range(1, n + 1):\n        r *= i\n    return r\n", "fixed": "def factorial(n):\n    r = 1\n    for i in range(1, n + 1):\n        r *= i\n    return r\n", "tests": ["factorial(4) == 24", "factorial(0) == 1"], "license": "CC0-1.0"}
{"id": "xon-bug-008", "entry": "in_range", "buggy": "def in_range(x, lo, hi):\n    return lo < x <= hi\n", "fixed": "def in_range(x, lo, hi):\n    return lo <= x <= hi\n", "tests": ["in_range(0, 0, 5)", "in_range(5, 0, 5)", "not in_range(6, 0, 5)"], "license": "CC0-1.0"}
{"id": "xon-bug-009", "entry": "double_all", "buggy": "def double_all(xs):\n    return [x + 2 for x in xs]\n", "fixed": "def double_all(xs):\n    return [x * 2 for x in xs]\n", "tests": ["double_all([1, 3]) == [2, 6]"], "license": "CC0-1.0"}
{"id": "xon-bug-010", "entry": "first_n", "buggy": "def first_n(xs, n):\n    return xs[:n - 1]\n", "fixed": "def first_n(xs, n):\n    return xs[:n]\n", "tests": ["first_n([1, 2, 3], 2) == [1, 2]"], "license": "CC0-1.0"}
{"id": "xon-bug-011", "entry": "is_empty", "buggy": "def is_empty(s):\n    return len(s) == 1\n", "fixed": "def is_empty(s):\n    return len(s) == 0\n", "tests": ["is_empty('')", "not is_empty('a')"], "license": "CC0-1.0"}
{"id": "xon-bug-012", "entry": "contrast_ok", "buggy": "def contrast_ok(ratio):\n    return ratio > 4.5\n", "fixed": "def contrast_ok(ratio):\n    return ratio >= 4.5\n", "tests": ["contrast_ok(4.5)", "not contrast_ok(4.4)"], "license": "CC0-1.0"}
{"id": "xon-bug-013", "entry": "px", "buggy": "def px(n):\n    return str(n) + 'em'\n", "fixed": "def px(n):\n    return str(n) + 'px'\n", "tests": ["px(4) == '4px'"], "license": "CC0-1.0"}
{"id": "xon-bug-014", "entry": "countdown", "buggy": "def countdown(n):\n    return list(range(n, 0, 1))\n", "fixed": "def countdown(n):\n    return list(range(n, 0, -1))\n", "tests": ["countdown(3) == [3, 2, 1]"], "license": "CC0-1.0"}
{"id": "xon-bug-015", "entry": "safe_div", "buggy": "def safe_div(a, b):\n    if b == 1:\n        return None\n    return a / b\n", "fixed": "def safe_div(a, b):\n    if b == 0:\n        return None\n    return a / b\n", "tests": ["safe_div(4, 0) is None", "safe_div(4, 1) == 4"], "license": "CC0-1.0"}
{"id": "xon-bug-016", "entry": "join_words", "buggy": "def join_words(ws):\n    return ''.join(ws)\n", "fixed": "def join_words(ws):\n    return ' '.join(ws)\n", "tests": ["join_words(['a', 'b']) == 'a b'"], "license": "CC0-1.0"}
{"id": "xon-bug-017", "entry": "min_val", "buggy": "def min_val(a, b):\n    return a if a > b else b\n", "fixed": "def min_val(a, b):\n    return a if a < b else b\n", "tests": ["min_val(1, 2) == 1", "min_val(5, 3) == 3"], "license": "CC0-1.0"}
{"id": "xon-bug-018", "entry": "square", "buggy": "def square(x):\n    return x * 2\n", "fixed": "def square(x):\n    return x * x\n", "tests": ["square(3) == 9"], "license": "CC0-1.0"}
{"id": "xon-bug-019", "entry": "odd_indices", "buggy": "def odd_indices(xs):\n    return xs[0::2]\n", "fixed": "def odd_indices(xs):\n    return xs[1::2]\n", "tests": ["odd_indices([0, 1, 2, 3]) == [1, 3]"], "license": "CC0-1.0"}
